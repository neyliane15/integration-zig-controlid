# Copie para .env e preencha com os dados do projeto Supabase (Project Settings → API).
# Só a chave pública (anon / publishable) vai no front. NUNCA coloque a service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
# Mostra o botão "Entrar com Google" (exige o provedor Google ligado no Supabase Auth).
VITE_LOGIN_GOOGLE=true
