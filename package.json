{
  "name": "meu-dia-de-gerente",
  "private": true,
  "version": "0.1.0",
  "description": "Meu Dia de Gerente — ponto (Control iD), vendas (Zig), comissões e tarefas para bares e restaurantes",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:banco": "supabase/testes/preparar-postgres.sh > /dev/null && supabase/testes/executar.sh",
    "sql:instalar": "ferramentas/gerar-instalar.sh",
    "local": "ferramentas/local/subir.sh",
    "test:e2e": "playwright test",
    "n8n:verificar": "node n8n/verificar.mjs",
    "n8n:mocks": "node n8n/mocks/servidor.mjs",
    "test:integracao": "MDG_INTEGRACAO_REAL=1 node --test --test-concurrency=1 n8n/integracao-real.test.mjs n8n/cenario-revisao2.test.mjs",
    "sql:conferir": "ferramentas/gerar-instalar.sh --conferir",
    "test:fuzz": "MDG_FUZZ_BANCO=1 vitest run web/src/lib/comissao.fuzz.test.ts web/src/lib/ponto.fuzz.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
