# Variáveis do N8N para o Meu Dia de Gerente (contrato §12.2).
# Self-hosted: coloque no ambiente do processo do N8N (docker-compose `environment:`, systemd, .env do compose).
# N8N Cloud: o acesso a $env é bloqueado — cadastre as mesmas chaves em Settings → Variables (os nós Code leem $env e, se não
# houver, $vars). NUNCA versione o arquivo preenchido (n8n/.env está no .gitignore).

# --- obrigatórias -------------------------------------------------------------------------------------------------------
# Supabase → Project Settings → API. A service_role ignora a RLS: só o N8N a conhece (nunca o front).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Ids dos subfluxos no SEU N8N (aparecem na URL do workflow depois de importar: /workflow/<id>).
MDG_WF_CONTROLID_USUARIOS=
MDG_WF_CONTROLID_BATIDAS=
MDG_WF_CONTROLID_EXPORTAR=
MDG_WF_ZIG_IMPORTAR=
MDG_WF_EXPORTAR_FECHAMENTO=

# Os nós Code precisam ler variáveis de ambiente.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Fuso dos agendamentos (a Rotina diária roda 05:30 neste fuso).
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- opcionais ----------------------------------------------------------------------------------------------------------
# API da Zig (padrão abaixo). Testes locais: http://127.0.0.1:54340/integration (mock: npm run n8n:mocks).
ZIG_BASE_URL=https://api.zigcore.com.br/integration
# Destino do CSV de comissão e dos avisos de erro (vazio = o Tratador de erros não manda e-mail; a exportação falha).
MDG_EMAIL_RELATORIOS=
# Remetente dos e-mails (padrão: o próprio MDG_EMAIL_RELATORIOS). Tem de ser aceito pelo seu SMTP.
MDG_EMAIL_REMETENTE=

# A importação da Zig roda vários minutos num nó Code (um dia por vez, pausa de 300 ms, retentativas de 10/20 s).
# Com task runners (N8N ≥ 1.80) o limite padrão de um nó Code é 60 s — aumente:
N8N_RUNNERS_TASK_TIMEOUT=900
# Limite geral de execução (segundos; -1 = sem limite).
EXECUTIONS_TIMEOUT=-1
